  "bracketed": [
    {
      "id": "bracketed-valid",
      "input": "(01)09506000134352(17)261231(10)ABC123",
      "requirements": [
        "REQ-GS1-002",
        "REQ-GS1-010"
      ],
      "expect": {
        "valid": true,
        "verdict": "Data valid",
        "elements": [
          {
            "ai": "01",
            "value": "09506000134352"
          },
          {
            "ai": "17",
            "value": "261231"
          },
          {
            "ai": "10",
            "value": "ABC123"
          }
