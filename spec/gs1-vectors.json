      ],
      "symbologyId": "]E0",
      "message": "0012345000065",
      "barcode": {
        "format": "UPCE",
        "content": "01234565"
      },
      "expect": {
        "kind": "gtin",
        "valid": true,
        "verdict": "Data valid",
