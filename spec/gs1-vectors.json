          },
          {
            "ai": "3103",
            "value": "000250"
          }
        ]
      }
    },
    {
      "id": "gs1-qr-batch",
      "label": "GS1 QR Code: GTIN and batch",
      "requirements": [
        "REQ-GS1-002",
        "REQ-GS1-003"
      ],
      "symbologyId": "]Q3",
      "message": "010950600013435210ABC123",
      "barcode": {
        "format": "QRCode",
        "content": "[01]09506000134352[10]ABC123",
        "gs1": true
      },
      "expect": {
        "kind": "gs1",
        "valid": true,
        "verdict": "Data valid",
        "elements": [
          {
