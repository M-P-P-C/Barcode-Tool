      ],
      "symbologyId": "]E4",
      "message": "96385074",
      "barcode": {
        "format": "EAN8",
        "content": "96385074"
      },
      "expect": {
        "kind": "gtin",
        "valid": true,
        "verdict": "Data valid",
        "elements": [
          {
            "ai": "01",
            "value": "00000096385074"
          }
        ]
      }
    },
    {
      "id": "databar-expanded-weight",
      "label": "GS1 DataBar Expanded: GTIN and net weight",
      "requirements": [
        "REQ-GS1-002",
        "REQ-GS1-003"
      ],
      "symbologyId": "]e0",
      "message": "01095060001343523103000250",
      "barcode": {
        "format": "DataBarExp",
        "content": "[01]09506000134352[3103]000250",
        "gs1": true
      },
      "expect": {
        "kind": "gs1",
        "valid": true,
